+// INKLING_SITU_A8: a SiTU node whose only consumer is an int8 (W4A8, 64-wide) expert matmul is not run;
+// the consumer quantises straight from the SiTU inputs. Both sites use this predicate, so they agree.
+static bool inkling_situ_a8_fusable(const ggml_cgraph * gf, const ggml_tensor * situ, bool has_tensor) {
+    static const bool on = std::getenv("INKLING_SITU_A8") != nullptr && std::getenv("INKLING_W4A8_G64") != nullptr;
+    if (!on || !has_tensor || !situ || !ggml_is_inkling_situ(situ) || situ->ne[3] != 1 ||
+        (situ->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+    const ggml_tensor * consumer = nullptr;
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        const ggml_tensor * n = gf->nodes[i];
+        if (n->view_src == situ) return false;
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (n->src[s] != situ) continue;
+            if (s != 1 || n->op != GGML_OP_MUL_MAT_ID || (consumer && consumer != n)) return false;
+            consumer = n;
+        }
+    }
+    return consumer && consumer->src[0]->ne[0] == situ->ne[0] && situ->ne[0] % 64 == 0 &&
+           ggml_metal_op_inkling_w4a8(consumer) >= 0;
