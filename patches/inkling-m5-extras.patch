+// INKLING_SITU_A8: compute the SiTU activation (same arithmetic as kernel_inkling_situ) while quantising
+// it for the int8 expert down projection, so the f32 activation is never written or read back.
+kernel void kernel_inkling_quant_a8g64_situ(
+        constant ggml_metal_kargs_inkling_a8 & args,
+        device const float4 * gates,
+        device const float4 * values,
+        device       char   * qa,
+        constant ulong * stride,
+        constant float * params,
+        constant int & mode,
+        uint tid [[thread_position_in_grid]],
+        ushort lane [[thread_index_in_simdgroup]]) {
+    #pragma clang fp reassociate(off) contract(off)
+    // 16 threads per 64-value group, one float4 each (dispatch is a multiple of 32, rows*G*16 % 16 == 0)
+    const int G = args.K / 64;
+    const int gid = tid / 16;
+    const short j = tid % 16;
+    const bool live = gid < args.nrows * G;
+    const int row = live ? gid / G : 0, g = live ? gid % G : 0;
+    const ulong i1 = row % args.ne11, i2 = row / args.ne11;
+    const ulong col = (ulong) g * 16 + j;
+    float4 v = 0.0f;
+    if (live && mode == 1) {
+        v = values[col + i1*stride[3] + i2*stride[4]];
+    } else if (live) {
+        const float4 gate = gates[col + i1*stride[0] + i2*stride[1]];
+        const float4 value = values[col + i1*stride[3] + i2*stride[4]];
+        volatile thread float4 nonlinear = params[0] * precise::tanh(gate * params[2]);
+        volatile thread float4 sigmoid = 1.0f / (1.0f + exp(-gate));
+        volatile thread float4 limited = params[1] > 0 ? params[1] * precise::tanh(value * params[3]) : value;
+        volatile thread float4 scaled = nonlinear * sigmoid;
+        v = scaled * limited;
+    }
+    const float4 av = abs(v);
+    float amax = max(max(av.x, av.y), max(av.z, av.w));
+    FOR_UNROLL (ushort o = 8; o > 0; o >>= 1) amax = max(amax, simd_shuffle_xor(amax, o));
+    const float d = amax / 127.0f;
+    const float id = amax > 0.0f ? 127.0f / amax : 0.0f;
+    const int4 c = clamp(int4(rint(v * id)), -127, 127);
+    int sum = c.x + c.y + c.z + c.w;
+    FOR_UNROLL (ushort o = 8; o > 0; o >>= 1) sum += simd_shuffle_xor(sum, o);
+    if (!live) return;
+    ((device char4 *)(qa + (uint64_t) row * args.K + g * 64))[j] = char4(c);
+    if (j == 0) {
+        ((device float *)(qa + args.off_s))[gid] = d;
+        ((device float *)(qa + args.off_m))[gid] = d * (float) sum;
+    }
+}
