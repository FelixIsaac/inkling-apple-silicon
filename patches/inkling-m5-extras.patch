+    if (!pipeline.pipeline) pipeline = ggml_metal_library_compile_pipeline(ctx->lib, qn, qn, nullptr);
+    uint64_t strides[6];
+    for (int i = 0; i < 6; ++i) strides[i] = situ->src[i / 3]->nb[1 + i % 3] / 16;
+    float params[4];
+    memcpy(&params[0], situ->op_params + GGML_INKLING_TAG_SLOT - 2, sizeof(float));
+    memcpy(&params[1], situ->op_params + GGML_INKLING_TAG_SLOT - 3, sizeof(float));
+    params[2] = 1.0f / params[0];
+    params[3] = params[1] > 0 ? 1.0f / params[1] : 0;
+    ggml_metal_encoder_set_pipeline(ctx->enc, pipeline);
+    ggml_metal_encoder_set_bytes   (ctx->enc, (void *) &a8, sizeof(a8), 0);
