+    ggml_metal_encoder_set_buffer  (ctx->enc, ggml_metal_get_buffer_id(situ->src[1]), 2);
+    ggml_metal_encoder_set_buffer  (ctx->enc, bid_qa, 3);
+    ggml_metal_encoder_set_bytes   (ctx->enc, strides, sizeof(strides), 4);
+    const int mode = std::getenv("INKLING_SITU_A8_DBG") ? 1 : 0;
